{
    "paths" : {
        "homebrew"  : "/opt/homebrew",
        "httpdConf" : "/opt/homebrew/etc/httpd/httpd.conf",
        "vhosts"    : "/opt/homebrew/etc/httpd/extra/httpd-vhosts.conf",
        "phpIni"    : "/opt/homebrew/etc/php/{php}/conf.d/99-local-dev.ini",
        "mysqlData" : "/opt/homebrew/var/mysql",
        "mysqlCnf"  : "/opt/homebrew/etc/my.cnf.d/local-dev.cnf",
        "apacheLog" : "/opt/homebrew/var/log/httpd/error_log",
        "accessLog" : "/opt/homebrew/var/log/httpd/access_log",
        "redisLog"  : "/opt/homebrew/var/log/redis.log",
        "hosts"     : "/etc/hosts",
        "certs"     : "~/.certs"
    },

    "browser"    : "Google Chrome",
    "editor"     : "Visual Studio Code",
    "phpMyAdmin" : "http://localhost/phpmyadmin",

    "projects" : [
        {
            "name"  : "Framework",
            "sites" : [
                {
                    "id"      : "docs",
                    "name"    : "Framework Docs",
                    "dir"     : "~/GitHub/Framework",
                    "command" : "./framework docs --port=2000"
                },
                {
                    "id"      : "tool",
                    "name"    : "Tool",
                    "dir"     : "~/GitHub/Tool",
                    "command" : "npm start"
                }
            ]
        },
        {
            "name" : "Blog",
            "dir"  : "~/Projects/Blog/blog-app"
        },
        {
            "name"  : "Clinic",
            "dir"   : "~/Projects/Clinic/clinic-admin",
            "host"  : "clinic.local",
            "https" : true,
            "sites" : [
                { "name" : "Site", "host" : "site.clinic.local", "https" : true }
            ]
        },
        {
            "name"      : "Shop",
            "dir"       : "~/Projects/Shop",
            "worktrees" : true,
            "mainApp"   : "desktop",
            "nestedApp" : "web"
        }
    ]
}
